# --- Vaultwarden configuration -------------------------------------------------
# Copy to .env and edit. See RUNBOOK.md

DOMAIN=https://vault.yourdomain.com   # <- set yours

# Open registration (you said anyone should be able to register).
# HARDEN LATER: after onboarding people, set to false - admin-panel invites still work.
SIGNUPS_ALLOWED=true
INVITATIONS_ALLOWED=true

# Optional: only allow signups from these email domains (comma-separated).
# Requires SMTP to be configured for verification.
#SIGNUPS_DOMAINS_WHITELIST=example.com

# Require email confirmation for signup/invites (needs SMTP block below enabled).
#SIGNUPS_VERIFY=true

# Admin panel token. MUST be an argon2 PHC string, NOT a plain password:
#   docker run --rm -it vaultwarden/server:latest /vaultwarden hash
# Single-quote the result in this file (it contains $ signs), or leave empty
# to disable /admin entirely.
ADMIN_TOKEN=

# --- Logging (used by fail2ban) ------------------------------------------------
LOG_FILE=/data/vw.log
LOG_LEVEL=warn

# Cloudflare sits in front, so the socket IP is a CF edge - use the real client IP.
IP_HEADER=CF-Connecting-IP

# --- Email (recommended: enables verification + invite mails) ------------------
#SMTP_HOST=smtp.example.com
#SMTP_FROM=vault@example.com
#SMTP_FROM_NAME=PassVault
#SMTP_PORT=587
#SMTP_SECURITY=starttls
#SMTP_USERNAME=vault@example.com
#SMTP_PASSWORD=changeme

# --- Optional extras -----------------------------------------------------------
#ATTACHMENTS_ENABLED=true
#ATTACHMENTS_SIZE_LIMIT=10485760
