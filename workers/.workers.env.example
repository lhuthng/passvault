# NodeWarden secrets - LOCAL/CI ONLY, never printed, never committed.
WORKERS_DOMAIN=vault.yourdomain.com   # <- set yours (must be a zone on your CF account)

# deploy.sh chmods this file 600 on first run and fills JWT_SECRET automatically.

# Runtime secret for the Worker (>= 32 random chars). Generated by deploy.sh.
JWT_SECRET=

# CI/CD only: Cloudflare API token (direct value - never a path, per project rule).
# Create at dash.cloudflare.com -> My Profile -> API Tokens -> "Edit Cloudflare Workers" template.
CLOUDFLARE_API_TOKEN=
